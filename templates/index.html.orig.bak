      <!-- Group Filter Chips -->
      <div class="sensors-filter-strip">
        <button class="sensor-filter-btn active" onclick="filterSensorGroup('', this)">Hamısı (39)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('greenhouse_temp', this)">İstixana Temperaturu (4)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('humidity', this)">Rütubət (4)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('weather', this)">Xarici Hava (6)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('heating', this)">Isıtma Sistemi (7)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('ventilation', this)">Ventilyasiya (2)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('co2', this)">CO₂ Sistemi (3)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('water', this)">Su Sistemi (2)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('water_quality', this)">Su Keyfiyyəti (6)</button>
        <button class="sensor-filter-btn" onclick="filterSensorGroup('energy', this)">Enerji (3)</button>
      </div>

