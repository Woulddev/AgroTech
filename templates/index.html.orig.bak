    <!-- ──────────────────────────────────────────
         TAB 4: ADMIN & THRESHOLD RULES
    ────────────────────────────────────────── -->
    <div id="view-admin" class="dashboard-view-panel">
      <!-- Admin Analytics Summary Row -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:22px">
        <div class="dash-card" style="padding:16px">
          <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;margin-bottom:6px">Cəmi Sensor Kanalları</div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:var(--accent-lime)">39</div>
          <div style="font-size:10px;color:var(--text-secondary);margin-top:4px">10 Qrup · 371 Fiziki Kanal</div>
        </div>
        <div class="dash-card" style="padding:16px">
          <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;margin-bottom:6px">Aktiv Threshold Qaydaları</div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:var(--accent-amber)" id="admin-threshold-count">6</div>
          <div style="font-size:10px;color:var(--text-secondary);margin-top:4px">Min/Max hədd monitorinqi</div>
        </div>
        <div class="dash-card" style="padding:16px">
          <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;margin-bottom:6px">Manual Overlay Data</div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:var(--accent-cyan)" id="admin-manual-count">1</div>
          <div style="font-size:10px;color:var(--text-secondary);margin-top:4px">Planlanan / ideal dəyərlər</div>
        </div>
        <div class="dash-card" style="padding:16px">
          <div style="font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;margin-bottom:6px">Tarix Əhatəsi (Data Coverage)</div>
          <div style="font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;color:var(--accent-teal)">6+ il</div>
          <div style="font-size:10px;color:var(--text-secondary);margin-top:4px">2020-01-25 → 2026-04-25</div>
        </div>
      </div>

      <div class="admin-grid-two">
        
        <!-- Threshold Limits Manager -->
        <div class="dash-card">
          <div class="dash-card-header">
            <span class="dash-card-title">
              <svg class="icon-svg" style="width:15px;height:15px;color:var(--accent-lime)" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              Hədd (Threshold) və Alert Qaydaları
            </span>
          </div>

          <form id="threshold-form" onsubmit="handleSaveThreshold(event)">
            <input type="hidden" id="admin-thresh-id">
            
            <div class="form-group-line">
              <label>Kanal Seçin</label>
              <select id="admin-thresh-channel" class="admin-input-txt" required>
                <!-- Populated via JS -->
              </select>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="form-group-line">
                <label>Minimum Hədd (Min)</label>
                <input type="number" step="any" id="admin-thresh-min" class="admin-input-txt" placeholder="məs: 14.0">
              </div>
              <div class="form-group-line">
                <label>Maksimum Hədd (Max)</label>
                <input type="number" step="any" id="admin-thresh-max" class="admin-input-txt" placeholder="məs: 28.0">
              </div>
            </div>

            <div class="form-group-line">
              <label>Qayda Başlığı / Qeyd</label>
              <input type="text" id="admin-thresh-lbl" class="admin-input-txt" placeholder="məs: Bölmə 1 Kritik Temperatur">
            </div>

            <button type="submit" class="btn-accent-primary" style="width:100%;justify-content:center;margin-top:6px">
              Qaydanı Saxla
            </button>
          </form>

          <div class="threshold-table-scroll" style="margin-top:20px">
            <table class="threshold-table">
              <thead>
                <tr>
                  <th>Kanal</th>
                  <th>Min</th>
                  <th>Max</th>
                  <th>Status</th>
                  <th>Əməliyyat</th>
                </tr>
              </thead>
              <tbody id="admin-threshold-tbody">
                <!-- Loaded via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- Manual Data & Import -->
        <div class="dash-card">
          <div class="dash-card-header">
            <span class="dash-card-title">
              <svg class="icon-svg" style="width:15px;height:15px;color:var(--accent-cyan)" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
              Manual Overlay & CSV/Excel Import
            </span>
          </div>

          <form id="manual-data-form" onsubmit="handleSaveManualData(event)">
            <div class="form-group-line">
              <label>Sensor Kanalı</label>
              <select id="admin-manual-channel" class="admin-input-txt" required>
                <!-- Populated via JS -->
              </select>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div class="form-group-line">
                <label>Tarix</label>
                <input type="date" id="admin-manual-date" class="admin-input-txt" value="2026-04-24" required>
              </div>
              <div class="form-group-line">
                <label>Saat</label>
                <input type="time" id="admin-manual-time" class="admin-input-txt" value="12:00" required>
              </div>
            </div>

            <div class="form-group-line">
              <label>Manual / Planlanan Dəyər</label>
              <input type="number" step="any" id="admin-manual-val" class="admin-input-txt" placeholder="məs: 22.5" required>
            </div>

            <button type="submit" class="btn-accent-primary" style="width:100%;justify-content:center">
              Manual Dəyəri Əlavə Et
            </button>
            <div id="manual-save-status" style="font-size:11px;color:var(--accent-teal);margin-top:6px;text-align:center"></div>
          </form>

          <!-- File Import -->
          <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--border)">
            <div class="dash-card-title" style="margin-bottom:12px;font-size:12.5px">Toplu Fayl İdxalı (CSV / JSON / Excel)</div>
            <input type="file" id="admin-import-file" class="admin-input-txt" style="width:100%" accept=".csv,.json,.xlsx,.xlsm">
            <div style="display:flex;gap:10px;margin-top:10px">
              <button type="button" class="ctrl-select-pill" onclick="handleImportPreview()" style="flex:1;text-align:center">Faylı Yoxla (Preview)</button>
              <button type="button" class="btn-accent-primary" onclick="handleImportSubmit()" style="flex:1;justify-content:center">İdxal Et</button>
            </div>
            <div id="import-preview-result" style="font-size:11px;color:var(--text-secondary);margin-top:8px"></div>
          </div>
        </div>

      </div>
    </div>

  </div>
</main>


<!-- ══════════════════════════════════════════
     POPUP MODAL (DETAILED DRILLDOWN & EXPORT)
══════════════════════════════════════════ -->
<div id="modal-drilldown" class="modal-backdrop" onclick="if(event.target===this)closeDrilldown()">
  <div class="modal-dialog">
    <div class="modal-header">
      <div>
        <h2 id="m-title" style="font-size:17px;font-weight:700">Sensor Detallı Analizi</h2>
        <p id="m-sub" style="font-size:11px;color:var(--text-muted);font-family:'JetBrains Mono',monospace;margin-top:3px"></p>
      </div>
      <button class="icon-action-btn" onclick="closeDrilldown()" title="Bağla">✕</button>
    </div>

    <div class="modal-body">
      <!-- Modal Controls Row -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
        <div style="display:flex;align-items:center;gap:6px">
          <button class="sensor-filter-btn active" id="m-gran-monthly" onclick="setDrilldownGran('monthly', this)">Aylıq</button>
          <button class="sensor-filter-btn" id="m-gran-daily" onclick="setDrilldownGran('daily', this)">Gündəlik</button>
          <button class="sensor-filter-btn" id="m-gran-hourly" onclick="setDrilldownGran('hourly', this)">Saatlıq (00:00-23:00)</button>
        </div>

        <div style="display:flex;align-items:center;gap:8px">
          <input type="date" id="m-date-from" class="ctrl-select-pill" onchange="renderDrilldownGraph()">
          <span style="color:var(--text-muted)">→</span>
          <input type="date" id="m-date-to" class="ctrl-select-pill" onchange="renderDrilldownGraph()">
          
          <button class="ctrl-select-pill" onclick="exportChartCsv('modal-chart-canvas')" title="CSV Fayl Yüklə">📥 CSV</button>
          <button class="ctrl-select-pill" onclick="exportChartPng('modal-chart-canvas')" title="Qrafiki Şəkil Kimi Saxla">📷 PNG</button>
        </div>
      </div>

      <!-- Canvas -->
      <div class="modal-chart-area">
        <canvas id="modal-chart-canvas"></canvas>
      </div>

      <!-- Quick Metrics Grid -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px">
        <div class="insp-box"><div class="insp-lbl">Orta Dəyər</div><div class="insp-val" id="m-avg">—</div></div>
        <div class="insp-box"><div class="insp-lbl">Minimum Dəyər</div><div class="insp-val" id="m-min">—</div></div>
        <div class="insp-box"><div class="insp-lbl">Maksimum Dəyər</div><div class="insp-val" id="m-max">—</div></div>
        <div class="insp-box"><div class="insp-lbl">Cəmi Ölçüm</div><div class="insp-val" id="m-cnt">—</div></div>
      </div>
    </div>
  </div>
</div>

<script>
window.__INITIAL_CHANNELS__ = {{ channels | tojson if channels is defined else '{}' }};
</script>
<script>
// ─── GLOBAL APPLICATION STATE ───
let SD = (window.__INITIAL_CHANNELS__ && Object.keys(window.__INITIAL_CHANNELS__).length > 0) ? window.__INITIAL_CHANNELS__ : {};
let CI = {}; // Chart Instances registry
let currentTab = 'dashboard';
let currentSelectedSensor = '10';
let currentInspectedSensorId = '10';
let currentDrilldownId = null;
let currentDrilldownGran = 'monthly';
let currentPeriod = '7d';

const GC = {
  weather: '#00d4aa',
  greenhouse_temp: '#ff6b6b',
  humidity: '#4ecdc4',
  heating: '#f7b731',
  ventilation: '#a29bfe',
  co2: '#6c5ce7',
  curtain: '#fd79a8',
  water: '#0984e3',
  water_quality: '#00b894',
  energy: '#e17055'
};

const GL = {
  weather: 'Xarici Hava',
  greenhouse_temp: 'İstixana Temperaturu',
  humidity: 'Rütubət',
  heating: 'Isıtma Sistemi',
  ventilation: 'Ventilyasiya',
  co2: 'CO₂ Sistemi',
  curtain: 'Pərdə Sistemi',
  water: 'Su Temperaturu',
  water_quality: 'Su Keyfiyyəti',
  energy: 'Enerji / Qaz'
};

// ─── INITIALIZATION ───
async function init() {
  initTheme();
  await loadChannels();
  populateDropdowns();
  renderMainBarChart();
  renderMainAreaChart();
  renderSensorCards('');
  loadThresholds();

  // Search input filter
  document.getElementById('global-search-input')?.addEventListener('input', (e) => {
    const q = e.target.value.trim().toLowerCase();
    if (q) {
      switchTab('sensors');
      renderSensorCards(q);
    }
  });

  // Keyboard shortcut Cmd/Ctrl + K to focus search
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      document.getElementById('global-search-input')?.focus();
    }
  });
}

// ─── DATA LOADING ───
async function loadChannels() {
  try {
    const res = await fetch('/api/channels');
    SD = await res.json();
  } catch (e) {
    console.error('Error fetching channels:', e);
  }
}

function cleanUnit(unit) {
  return (unit || '').replace(/C/g, '°C').replace(/m\/h/g, 'm³/h').replace(/\uFFFD/g, '°');
}

// ─── TAB NAVIGATION ───
function switchTab(tabId) {
  currentTab = tabId;
  document.querySelectorAll('.dashboard-view-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.rail-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.nav-tab-pill').forEach(b => b.classList.remove('active'));

  document.getElementById(`view-${tabId}`)?.classList.add('active');
  document.getElementById(`rail-tab-${tabId}`)?.classList.add('active');
  document.getElementById(`subtab-${tabId}`)?.classList.add('active');

  if (tabId === 'dashboard') {
    renderMainBarChart();
    renderMainAreaChart();
  } else if (tabId === 'compartments') {
    renderInspectorMiniChart();
  }
}

// ─── POPULATE ADMIN DROPDOWNS ───
function populateDropdowns() {
  const tSel = document.getElementById('admin-thresh-channel');
  const mSel = document.getElementById('admin-manual-channel');
  if (!tSel || !mSel) return;

  const entries = Object.entries(SD).sort((a,b) => parseInt(a[0]) - parseInt(b[0]));
  const html = entries.map(([id, info]) => `<option value="${id}">${id} · ${escapeHtml(info.name)} (${cleanUnit(info.unit)})</option>`).join('');
  tSel.innerHTML = html;
  mSel.innerHTML = html;
}

// ─── CHART 1: MAIN COLUMN BAR CHART (FLEET UTILIZATION STYLE) ───
async function renderMainBarChart() {
  const ctx = document.getElementById('main-bar-chart');
  if (!ctx) return;

  const chId = document.getElementById('main-metric-selector')?.value || '10';
  const ch = SD[chId];
  if (!ch) return;

  const unit = cleanUnit(ch.unit);
  let labels = [], dataVals = [];

  try {
    const res = await fetch(`/api/channel/${chId}`);
    const full = await res.json();
    const daily = full.daily || {};
    const keys = Object.keys(daily);

    let count = 7;
    if (currentPeriod === '30d') count = 30;
    else if (currentPeriod === 'all') count = 90;
    else if (currentPeriod === '1d') count = 1;

    const sliceKeys = keys.slice(-count);
    labels = sliceKeys.map(k => k.slice(5)); // 'MM-DD'
    dataVals = sliceKeys.map(k => daily[k]);

  } catch (err) {
    labels = ['2 Bzr', '3 B.e', '4 Ç.a', '5 Çər', '6 Cüm', '7 Şən', '8 Bzr'];
    dataVals = [18.2, 18.5, 18.4, 22.4, 19.1, 18.9, 19.5];
  }

  // Find max value to highlight active bar in glowing cyan (Mockup 1 style)
  const maxIdx = dataVals.indexOf(Math.max(...dataVals));
  const bgColors = dataVals.map((_, idx) => idx === maxIdx ? '#38bdf8' : 'rgba(0, 240, 170, 0.35)');
  const borderColors = dataVals.map((_, idx) => idx === maxIdx ? '#38bdf8' : '#00f0aa');

  if (CI['main-bar-chart']) CI['main-bar-chart'].destroy();

  CI['main-bar-chart'] = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: `${ch.name} (${unit})`,
        data: dataVals,
        backgroundColor: bgColors,
        borderColor: borderColors,
        borderWidth: 1.5,
        borderRadius: 8,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#111724',
          borderColor: '#2d3d5c',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#f8fafc',
          callbacks: {
            label: (c) => ` Dəyər: ${c.parsed.y} ${unit}`
          }
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: cssVar('--text-muted'), font: { family: 'JetBrains Mono', size: 10 } }
        },
        y: {
          grid: { color: 'rgba(255, 255, 255, 0.04)' },
          ticks: { color: cssVar('--text-muted'), font: { family: 'JetBrains Mono', size: 10 } }
        }
      }
    }
  });
}

// ─── CHART 2: ON-TIME PERFORMANCE SMOOTH AREA WAVE (MOCKUP 1 STYLE) ───
async function renderMainAreaChart() {
  const ctx = document.getElementById('main-area-chart');
  if (!ctx) return;

  const chId = '14'; // Humidity CMP1
  const ch = SD[chId] || { name: 'REL HUMIDITY', unit: '%' };
  const unit = cleanUnit(ch.unit);

  let labels = [], dataVals = [];
  try {
    const res = await fetch(`/api/channel/${chId}`);
    const full = await res.json();
    const daily = full.daily || {};
    const keys = Object.keys(daily).slice(-30);
    labels = keys.map(k => k.slice(5));
    dataVals = keys.map(k => daily[k]);
  } catch (err) {
    labels = Array.from({length: 20}, (_, i) => `G-${i+1}`);
    dataVals = [64, 65, 62, 68, 70, 69, 72, 68, 64, 66, 65, 63, 67, 69, 68, 70, 71, 65, 64, 66];
  }

  if (CI['main-area-chart']) CI['main-area-chart'].destroy();

  CI['main-area-chart'] = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: `Rütubət Balansı (%)`,
        data: dataVals,
        borderColor: '#a855f7',
        backgroundColor: 'rgba(168, 85, 247, 0.15)',
        fill: true,
        tension: 0.4,
        borderWidth: 2,
        pointRadius: 0,
        pointHoverRadius: 5
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#111724',
          borderColor: '#2d3d5c',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#f8fafc'
        }
      },
      scales: {
        x: {
          grid: { display: false },
          ticks: { color: cssVar('--text-muted'), font: { family: 'JetBrains Mono', size: 10 }, maxTicksLimit: 10 }
        },
        y: {
          grid: { color: 'rgba(255, 255, 255, 0.04)' },
          ticks: { color: cssVar('--text-muted'), font: { family: 'JetBrains Mono', size: 10 } }
        }
      }
    }
  });
}

// ─── CARGO COMPARTMENTS INSPECTOR ───
function inspectCompartment(el, code, name, tId, hId, pId, vId) {
  document.querySelectorAll('.comp-cell-card').forEach(c => c.classList.remove('selected'));
  if (el) el.classList.add('selected');

  document.getElementById('insp-header-name').textContent = `${name} İcmalı`;
  document.getElementById('insp-header-code').textContent = code;

  const tVal = SD[tId] ? `${SD[tId].avg_val.toFixed(2)} ${cleanUnit(SD[tId].unit)}` : '18.6 °C';
  const hVal = SD[hId] ? `${SD[hId].avg_val.toFixed(2)} ${cleanUnit(SD[hId].unit)}` : '64.2 %';
  const pVal = SD[pId] ? `${SD[pId].avg_val.toFixed(2)} ${cleanUnit(SD[pId].unit)}` : '20.7 °C';
  const vVal = SD[vId] ? `${SD[vId].avg_val.toFixed(2)} ${cleanUnit(SD[vId].unit)}` : '20.8 %';

  document.getElementById('insp-temp').textContent = tVal;
  document.getElementById('insp-hum').textContent = hVal;
  document.getElementById('insp-pipe').textContent = pVal;
  document.getElementById('insp-vent').textContent = vVal;

  currentInspectedSensorId = tId;
  renderInspectorMiniChart();
}

function renderInspectorMiniChart() {
  const ctx = document.getElementById('insp-mini-chart');
  if (!ctx) return;
  if (CI['insp-mini-chart']) CI['insp-mini-chart'].destroy();

  CI['insp-mini-chart'] = new Chart(ctx, {
    type: 'line',
    data: {
      labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00', '23:00'],
      datasets: [{
        data: [17.8, 17.5, 18.2, 21.4, 20.1, 18.9, 18.2],
        borderColor: '#00f0aa',
        backgroundColor: 'rgba(0, 240, 170, 0.12)',
        fill: true,
        tension: 0.35,
        borderWidth: 2,
        pointRadius: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { display: false }, ticks: { color: '#64748b', font: { size: 9 } } },
        y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#64748b', font: { size: 9 } } }
      }
    }
  });
}

// ─── TAB 3: RENDER SENSOR CARDS ───
let currentSensorGroupFilter = '';

function filterSensorGroup(group, btn) {
  currentSensorGroupFilter = group;
  document.querySelectorAll('.sensor-filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  renderSensorCards(document.getElementById('global-search-input')?.value.trim().toLowerCase());
}

function renderSensorCards(query = '') {
  const container = document.getElementById('sensors-card-container');
  if (!container) return;

  const entries = Object.entries(SD);
  const filtered = entries.filter(([id, s]) => {
    if (currentSensorGroupFilter && s.group !== currentSensorGroupFilter) return false;
    if (query) {
      const match = id.includes(query) || s.name.toLowerCase().includes(query) || (GL[s.group]||'').toLowerCase().includes(query);
      if (!match) return false;
    }
    return true;
  });

  if (!filtered.length) {
    container.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--text-muted)">Axtarışa uyğun sensor tapılmadı.</div>';
    return;
  }

  const groupColor = (g) => GC[g] || '#00f0aa';
  container.innerHTML = filtered.map(([id, s]) => {
    const color = groupColor(s.group);
    const unit = cleanUnit(s.unit);
    return `
    <div class="sensor-card-item" style="--card-accent:${color}" onclick="openDrilldown('${id}')">
      <div class="sensor-card-head">
        <div>
          <span style="font-size:9.5px;font-family:'JetBrains Mono',monospace;color:var(--text-muted)">CH-${id} · ${GL[s.group] || s.group}</span>
          <div class="sensor-name-lbl">${escapeHtml(s.name)}</div>
        </div>
        <span class="sensor-unit-tag" style="color:${color};background:${color}18">${unit}</span>
      </div>

      <div class="sensor-avg-big">
        ${s.avg_val.toFixed(2)}
        <span class="unit-suffix">${unit}</span>
      </div>

      <div class="sensor-stats-triplet">
        <div class="sensor-stat-mini">
          <span class="s-lbl">ORTA</span>
          <span class="s-val">${s.avg_val.toFixed(2)}</span>
        </div>
        <div class="sensor-stat-mini">
          <span class="s-lbl">MİN</span>
          <span class="s-val">${s.min_val.toFixed(2)}</span>
        </div>
        <div class="sensor-stat-mini">
          <span class="s-lbl">MAX</span>
          <span class="s-val">${s.max_val.toFixed(2)}</span>
        </div>
      </div>

      <div class="sensor-card-footer">
        <span>${s.total_records.toLocaleString()} ölçüm</span>
        <span class="view-link">Baxış ↗</span>
      </div>
    </div>
  `;}).join('');
}

// ─── TAB 4: THRESHOLDS & ALERTS ───
async function loadThresholds() {
  const tbody = document.getElementById('admin-threshold-tbody');
  if (!tbody) return;

  try {
    const res = await fetch('/api/thresholds');
    const thresholds = await res.json();
    if (!thresholds.length) {
      tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--text-muted);padding:14px">Qayda tapılmadı.</td></tr>';
      return;
    }

    tbody.innerHTML = thresholds.map(t => `
      <tr>
        <td><strong>#${t.channel_id}</strong> ${escapeHtml(t.label || t.channel_name || '')}</td>
        <td style="color:var(--accent-cyan);font-family:'JetBrains Mono',monospace">${t.min_value ?? '—'}</td>
        <td style="color:var(--accent-amber);font-family:'JetBrains Mono',monospace">${t.max_value ?? '—'}</td>
        <td><span class="alert-pill-badge ${t.enabled ? 'warning' : ''}">${t.enabled ? 'Aktiv' : 'Deaktiv'}</span></td>
        <td>
          <button class="ctrl-select-pill" style="padding:3px 8px;font-size:10px" onclick="deleteThreshold('${t.id}')">Sil</button>
        </td>
      </tr>
    `).join('');
  } catch (err) {}
}

async function handleSaveThreshold(e) {
  e.preventDefault();
  const payload = {
    channel_id: document.getElementById('admin-thresh-channel').value,
    min_value: document.getElementById('admin-thresh-min').value,
    max_value: document.getElementById('admin-thresh-max').value,
    label: document.getElementById('admin-thresh-lbl').value,
    enabled: true
  };
  const res = await fetch('/api/admin/thresholds', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });
  if (res.ok) {
    alert('Hədd qaydası saxlanıldı!');
    loadThresholds();
  }
}

async function deleteThreshold(id) {
  if (!confirm('Qaydanı silmək istədiyinizə əminsiniz?')) return;
  await fetch(`/api/admin/thresholds/${id}`, { method: 'DELETE' });
  loadThresholds();
}

// ─── MANUAL DATA ───
function openManualEntryModal() {
  switchTab('admin');
  document.getElementById('admin-manual-val')?.focus();
}

async function handleSaveManualData(e) {
  e.preventDefault();
  const payload = {
    channel_id: document.getElementById('admin-manual-channel').value,
    date: document.getElementById('admin-manual-date').value,
    time: document.getElementById('admin-manual-time').value,
    value: document.getElementById('admin-manual-val').value,
    enabled: true
  };
  const res = await fetch('/api/admin/manual-data', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  });
  if (res.ok) {
    document.getElementById('manual-save-status').textContent = 'Manual dəyər qeydə alındı!';
    setTimeout(() => document.getElementById('manual-save-status').textContent = '', 3000);
  }
}

// ─── DRILLDOWN MODAL ───
function openDrilldown(id) {
  if (!SD || !SD[id]) return;
  currentDrilldownId = id;
  currentDrilldownGran = 'monthly';
  const ch = SD[id];

  document.getElementById('m-title').textContent = `${ch.name} (${cleanUnit(ch.unit)})`;
  document.getElementById('m-sub').textContent = `Kanal #${id} · Qrup: ${GL[ch.group] || ch.group} · Tarix Aralığı: ${ch.date_from} → ${ch.date_to}`;

  document.getElementById('m-avg').textContent = `${ch.avg_val.toFixed(2)} ${cleanUnit(ch.unit)}`;
  document.getElementById('m-min').textContent = `${ch.min_val.toFixed(2)} ${cleanUnit(ch.unit)}`;
  document.getElementById('m-max').textContent = `${ch.max_val.toFixed(2)} ${cleanUnit(ch.unit)}`;
  document.getElementById('m-cnt').textContent = ch.total_records.toLocaleString();

  document.getElementById('m-date-from').value = ch.date_from;
  document.getElementById('m-date-to').value = ch.date_to;

  renderDrilldownGraph();
  document.getElementById('modal-drilldown').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closeDrilldown() {
  document.getElementById('modal-drilldown').classList.remove('open');
  document.body.style.overflow = '';
}

function setDrilldownGran(g, btn) {
  currentDrilldownGran = g;
  document.querySelectorAll('#modal-drilldown .sensor-filter-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  renderDrilldownGraph();
}

async function renderDrilldownGraph() {
  if (!currentDrilldownId || !SD[currentDrilldownId]) return;
  const ch = SD[currentDrilldownId];
  const unit = cleanUnit(ch.unit);
  const fromV = document.getElementById('m-date-from').value;
  const toV = document.getElementById('m-date-to').value;
  const effective = (fromV && toV && fromV === toV) ? 'hourly' : currentDrilldownGran;

  try {
    const params = new URLSearchParams({ granularity: effective });
    if (fromV) params.set('from', fromV);
    if (toV) params.set('to', toV);

    const res = await fetch(`/api/channel/${currentDrilldownId}/series?${params.toString()}`);
    const series = await res.json();

    const ctx = document.getElementById('modal-chart-canvas');
    if (!ctx) return;
    if (CI['modal-chart-canvas']) CI['modal-chart-canvas'].destroy();

    const labels = series.labels || [];
    const values = series.values || [];
    const manual = (series.manual && series.manual.values) || [];
    const hasManual = manual.some(v => v !== null && v !== undefined);

    const datasets = [{
      label: `${ch.name} (${unit})`,
      data: values,
      borderColor: '#00f0aa',
      backgroundColor: 'rgba(0, 240, 170, 0.12)',
      borderWidth: 2,
      pointRadius: labels.length > 80 ? 0 : 3,
      tension: 0.35,
      fill: true
    }];

    if (hasManual) {
      datasets.push({
        label: `${ch.name} (Plan Overlay)`,
        data: manual,
        borderColor: '#f59e0b',
        borderWidth: 2,
        borderDash: [5, 4],
        pointRadius: labels.length > 80 ? 0 : 3,
        fill: false
      });
    }

    CI['modal-chart-canvas'] = new Chart(ctx, {
      type: 'line',
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: hasManual, labels: { color: '#94a3b8' } },
          tooltip: {
            backgroundColor: '#111724',
            borderColor: '#2d3d5c',
            titleColor: '#94a3b8',
            bodyColor: '#f8fafc'
          }
        },
        scales: {
          x: { grid: { color: 'rgba(255, 255, 255, 0.04)' }, ticks: { color: '#64748b', font: { size: 10 }, maxTicksLimit: 16 } },
          y: { grid: { color: 'rgba(255, 255, 255, 0.04)' }, ticks: { color: '#64748b', font: { size: 10 } } }
        }
      }
    });

  } catch (err) {
    console.error(err);
  }
}

// ─── PERIOD CHANGER ───
function onPeriodChange(period) {
  currentPeriod = period;
  renderMainBarChart();
  renderMainAreaChart();
}

// ─── EXPORT HELPERS ───
function exportChartPng(cid) {
  const c = CI[cid];
  if (!c) return;
  const a = document.createElement('a');
  a.href = c.toBase64Image('image/png', 1);
  a.download = `priva-telemetry-${new Date().toISOString().slice(0,10)}.png`;
  a.click();
}

function exportChartCsv(cid) {
  const c = CI[cid];
  if (!c) return;
  const rows = [['Tarix / Saat', ...c.data.datasets.map(d => d.label)]];
  c.data.labels.forEach((lbl, idx) => {
    rows.push([lbl, ...c.data.datasets.map(d => d.data[idx] ?? '')]);
  });
  const csv = rows.map(r => r.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',')).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `priva-telemetry-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
}

// ─── THEME & UTILITIES ───
function initTheme() {
  const t = localStorage.getItem('greenhouse-theme') || 'dark';
  document.documentElement.setAttribute('data-theme', t);
}
function toggleTheme() {
  const cur = document.documentElement.getAttribute('data-theme');
  const nxt = cur === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', nxt);
  localStorage.setItem('greenhouse-theme', nxt);
  renderMainBarChart();
  renderMainAreaChart();
}
function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
function escapeHtml(str) {
  return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
}

window.addEventListener('load', init);
</script>
</body>
</html>
